{
  "build_root_dir": "third_party",
  "target_dir": "angle",
  "moz_build_flag": "build_mozilla_angle",
  "mozilla_add_override_dir": "",
  "use_gecko_shared_libraries": true,
  "gn_target": {
    "*": "//:translator",
    "android": "//:libEGL",
    "mac": "//:libEGL",
    "win": "//:libEGL"
  },
  "gn_args": {
    "*": {
      "angle_build_all": false,
      "angle_enable_abseil": false,
      "angle_build_vulkan_system_info": false,
      "angle_enable_d3d9": false,
      "angle_enable_d3d11": false,
      "angle_enable_essl": true,
      "angle_enable_gl": false,
      "angle_enable_glsl": true,
      "angle_enable_hlsl": false,
      "angle_enable_metal": false,
      "angle_enable_msl": false,
      "angle_enable_null": false,
      "angle_enable_vulkan": false,
      "angle_enable_wgpu": false,
      "angle_has_frame_capture": false,
      "angle_standalone": false,
      "angle_use_wayland": false,
      "enable_rust": false,
      "is_component_build": false,
      "use_custom_libcxx": false,
      "use_sysroot": false
    },
    "android": {
      "angle_build_vulkan_system_info": true,
      "angle_enable_vulkan": true,
      "vma_vulkan_headers_dir": "//angle/third_party/vulkan-headers/src"
    },
    "mac": {
      "angle_enable_metal": true,
      "angle_enable_msl": true
    },
    "win": {
      "angle_enable_d3d11": true,
      "angle_enable_hlsl": true
    }
  },
  "gn_sandbox_variables": {
    "default": {
      "COMPILE_FLAGS": {
        "WARNINGS_AS_ERRORS": []
      },
      "DEFINES": {
        "ANGLE_PLATFORM_EXPORT": ""
      }
    },
    "per_target": {
      "//third_party/vulkan-validation-layers/src:VkLayer_khronos_validation": {
        "COMPILE_FLAGS": {
          "VISIBILITY": []
        }
      }
    }
  },
  "mozilla_flags": ["-Wno-unguarded-availability", "-frtti"],
  "action_path_hints": {
    "third_party/spirv-tools/src/utils/ggt.py": {
      "next_arg_path": ["--spirv-core-grammar"],
      "prefixed_arg_path": [
        "--extinst=,",
        "--extinst=SHDEBUG100_,",
        "--extinst=CLDEBUG100_,"
      ]
    },
    "third_party/spirv-tools/src/utils/generate_language_headers.py": {
      "next_arg_path": ["--extinst-grammar"]
    },
    "third_party/spirv-tools/src/utils/generate_registry_tables.py": {
      "next_arg_path": ["--xml"]
    }
  },
  "write_mozbuild_variables": {
    "INCLUDE_GECKO_ZLIB_HANDLING": [
      "third_party/angle/third_party/zlib/zlib_gn"
    ]
  },
  "non_unified_sources": [
    "third_party/angle/src/compiler/preprocessor/preprocessor_tab_autogen.cpp",
    "third_party/angle/src/compiler/translator/VariablePacker.cpp",
    "third_party/angle/src/compiler/translator/glslang_lex_autogen.cpp",
    "third_party/angle/src/compiler/translator/glslang_tab_autogen.cpp",
    "third_party/angle/src/compiler/translator/msl/AstHelpers.cpp",
