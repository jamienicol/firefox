  ### This moz.build was AUTOMATICALLY GENERATED from a GN config,  ###
  ### DO NOT edit it by hand.                                       ###

COMPILE_FLAGS["OS_INCLUDES"] = []
AllowCompilerWarnings()

DEFINES["ANDROID"] = True
DEFINES["ANDROID_NDK_VERSION_ROLL"] = "r27_1"
DEFINES["ANGLE_PLATFORM_EXPORT"] = ""
DEFINES["DYNAMIC_ANNOTATIONS_ENABLED"] = "1"
DEFINES["HAVE_SYS_UIO_H"] = True
DEFINES["_DEBUG"] = True
DEFINES["_GNU_SOURCE"] = True
DEFINES["__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__"] = True
DEFINES["__STDC_CONSTANT_MACROS"] = True
DEFINES["__STDC_FORMAT_MACROS"] = True

LOCAL_INCLUDES += [
    "!/ipc/ipdl/_ipdlheaders",
    "!/third_party/angle/gen",
    "!/third_party/angle/gen/third_party/spirv-tools/src",
    "/ipc/chromium/src",
    "/third_party/angle/",
    "/third_party/angle/third_party/spirv-headers/src/include/",
    "/third_party/angle/third_party/spirv-tools/src/",
    "/third_party/angle/third_party/spirv-tools/src/include/",
    "/tools/profiler/public"
]

UNIFIED_SOURCES += [
    "/third_party/angle/third_party/spirv-tools/src/source/link/fnvar.cpp",
    "/third_party/angle/third_party/spirv-tools/src/source/link/linker.cpp"
]

USE_LIBS += [
    "spvtools_gn",
    "spvtools_headers_gn",
    "spvtools_opt_gn",
    "spvtools_val_gn"
]

if CONFIG["TARGET_CPU"] == "aarch64":

    DEFINES["__ARM_NEON__"] = "1"

Library("spvtools_link_gn")
